    "react-scripts": "5.0.1",
    "three": "^0.183.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:start\"",
    "dev:api": "tsx watch scripts/dev-api.ts",
